# LexFlow 生产环境变量模板（arch/08 §5：密钥占位，禁止真值入库）。
# 用法：cp .env.production.example .env.production，按下述指引填值；
# .env.production 已被 .gitignore 拦挡，不得提交。

# ---- Postgres（容器内服务，宿主不发布端口）----
POSTGRES_USER=lexflow
POSTGRES_PASSWORD=<请设置强口令，例：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))">
POSTGRES_DB=lexflow

# ---- Server ----
# 会话签名密钥，至少 16 字符，必须重新生成、禁止复用开发值
SESSION_SECRET=<请生成32字节随机：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
SESSION_TTL_HOURS=8
# 单文件上传上限（MB），需 ≤ nginx client_max_body_size(25m)
FILE_MAX_MB=20

# ---- Web ----
# 对外访问端口：http://localhost:8080（开发栈占用 3000/3001/15432，勿冲突）
WEB_PORT=8080
