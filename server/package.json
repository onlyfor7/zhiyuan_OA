{
  "name": "@lexflow/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.config.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/trpc-server": "^0.4.2",
    "@lexflow/shared": "*",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
